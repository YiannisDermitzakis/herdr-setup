def names_a_mutation(argv: list[str]) -> bool:
    """Whether any query field of a `gh api graphql` call contains `mutation`."""
    if argv[:2] != ["api", "graphql"]:
        return False
    for word in argv:
        for prefix in ("query=", "--raw-field=query=", "--field=query="):
            if word.startswith(prefix) and re.search(r"\bmutation\b", word[len(prefix) :]):
                return True
    return False


def main(argv: list[str]) -> int:
    log_call(argv)
    # The tripwire comes before every switch: FAKE_GH_FAIL must not be able
    # to turn a refused mutation into an ordinary-looking failure.
    if names_a_mutation(argv):
        sys.stderr.write("fake gh: refusing a GraphQL mutation; nothing under test may write\n")
        return 1
    if failing(" ".join(argv)):
        sys.stderr.write(f"gh: {os.environ['FAKE_GH_FAIL']} failed (FAKE_GH_FAIL)\n")
        return 1
    if argv[:2] == ["auth", "status"]:
        return auth_status(argv[2:])
    if argv[:1] == ["api"]:
        call = parse_api(argv[1:])
        if call.endpoint == "user":
            return rest_user(call)
        if call.endpoint == "user/orgs":
            return rest_user_orgs(call)
        if call.endpoint == "graphql":
            return graphql(call)
        refuse(f"api: endpoint {call.endpoint!r} is not faked")
    refuse(f"not faked: gh {' '.join(argv)}")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as exc:
        sys.stderr.write(f"fake gh: {exc}\n")
        sys.exit(2)
