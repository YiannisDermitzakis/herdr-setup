#!/usr/bin/env bash
# herdr-setup: reproduce and sync a Herdr setup across machines.
#
# See docs/superpowers/specs/2026-09-08-herdr-setup-design.md for the design.
# Bash 3.2 floor (macOS): no associative arrays, no mapfile, no `local -n`.
# Python comes from uv, not from the host -- see AGENTS.md.
set -euo pipefail

# Resolve the directory this script lives in, following symlinks, so it can
# be invoked as (or symlinked from) anywhere and still find lib/ next to it.
hs_resolve_root() {
  local target="$1"
  local dir
  while [ -h "$target" ]; do
    dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    case "$target" in
      /*) ;;
      *) target="$dir/$target" ;;
    esac
  done
  cd -P "$(dirname "$target")" && pwd
}

HS_ROOT="$(hs_resolve_root "$0")"
# shellcheck source=lib/common.sh
. "$HS_ROOT/lib/common.sh"

hs_usage() {
  cat <<'EOF'
usage: herdr-setup [--dry-run] [--yes] <command> [args]

commands:
  diff      report how this host differs from the checkout (read-only)
  apply     install missing plugins and splice the checkout's config in
  absorb    rewrite the checkout from this host's Herdr configuration
  onboard   detect coding agents and offer their Herdr integration
  feed      report live agent sessions to Herdr so a restart can resume them
EOF
}

HS_DRY_RUN=0
HS_YES=0
HS_COMMAND=""
HS_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      hs_usage
      exit 0
      ;;
    --dry-run)
      HS_DRY_RUN=1
      shift
      ;;
    --yes)
      HS_YES=1
      shift
      ;;
    diff|apply|absorb|onboard|feed)
      if [ -z "$HS_COMMAND" ]; then
        HS_COMMAND="$1"
      else
        HS_ARGS+=("$1")
      fi
      shift
      ;;
    *)
      if [ -z "$HS_COMMAND" ]; then
        echo "herdr-setup: unknown subcommand '$1'" >&2
        exit 2
      fi
      HS_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -z "$HS_COMMAND" ]; then
  hs_usage >&2
  exit 2
fi

export HS_DRY_RUN
export HS_YES

# cmd_diff: read-only. hs_preflight_banner prints first, so a mismatched
# or serverless host says so up front. Each section below reports its own
# drift and contributes to the overall exit status; none of them stop
# early on a soft failure, so one section's drift doesn't hide another
# section's report. A section is run with `|| section_rc=$?` (never as a
# bare statement) so a nonzero exit doesn't trip this script's `set -e`
# before the status is captured. The integration section never affects
# the exit status at all (informational only -- integrations aren't in
# the manifest), so it is invoked with `|| true` and never contributes to
# $rc.
#
# Exit status: 2 if any section hit a hard parse error (missing/malformed
# manifest or host state) -- which also skips every section after it --
# else 1 if anything drifted, else 0.
cmd_diff() {
  local rc=0
  local plugins_rc=0
  local config_rc=0

  hs_preflight_banner

  hs_diff_plugins "$HS_ROOT/manifest/plugins.list" "$(hs_plugins_json_path)" || plugins_rc=$?

  if [ "$plugins_rc" -eq 2 ]; then
    return 2
  fi
  if [ "$plugins_rc" -ne 0 ]; then
    rc=1
  fi

  hs_diff_config "$(hs_config_toml_path)" "$HS_ROOT/manifest/config.toml" || config_rc=$?

  if [ "$config_rc" -eq 2 ]; then
    return 2
  fi
  if [ "$config_rc" -ne 0 ]; then
    rc=1
  fi

  hs_diff_integrations || true

  return "$rc"
}
# cmd_apply: installs missing/moved plugins and splices the manifest's
# config into the host, in that order. hs_require_socket runs FIRST and
# unconditionally -- unlike cmd_diff, apply needs the socket (to install
# plugins and to reload the host's config) and must not proceed to a
# partial result under a protocol mismatch, matching the design doc's
# "apply, onboard, and feed stop with one line naming the mismatch ...
# rather than proceeding to a confusing partial result." This holds even
# under --dry-run: a dry run's whole point is to show what a real apply
# would do, and a mismatched host cannot answer that either.
#
# Both halves are invoked as `section || section_rc=$?` (never bare),
# same as cmd_diff, because of `set -e`. A hard error (2) from either
# section short-circuits the other and returns 2 immediately; a refused
# config write (4, hs_apply_config's shrinking-write gate) is passed
# through unchanged, so "refused, nothing written" stays distinguishable
# from "tried and failed" -- the same meaning exit 4 carries for absorb's
# dirty-manifest guard. Otherwise a non-zero rc from either section (a
# failed install or a failed reload-config call) makes the whole command
# exit 1.
cmd_apply() {
  hs_require_socket || return 3

  local plugins_rc=0
  local config_rc=0

  hs_apply_plugins "$HS_ROOT/manifest/plugins.list" "$(hs_plugins_json_path)" || plugins_rc=$?
  if [ "$plugins_rc" -eq 2 ]; then
    return 2
  fi

  hs_apply_config "$(hs_config_toml_path)" "$HS_ROOT/manifest/config.toml" || config_rc=$?
  if [ "$config_rc" -eq 2 ]; then
    return 2
  fi
  if [ "$config_rc" -eq 4 ]; then
    return 4
  fi

  if [ "$plugins_rc" -ne 0 ] || [ "$config_rc" -ne 0 ]; then
    return 1
  fi
  return 0
}
# cmd_absorb: the reverse of apply -- rewrites manifest/plugins.list and
# manifest/config.toml FROM the host's own Herdr state (plugins.json and
# config.toml, both read straight from disk, exactly like the plugin and
# config sections of `diff`). It never calls herdr at all, so unlike
# apply/onboard/feed it does not gate on hs_require_socket -- there is no
# socket call here to be blocked by a protocol mismatch.
#
# It overwrites rather than merges, so hs_require_clean_manifest runs
# first and unconditionally: a dirty manifest/ (uncommitted changes,
# hand-edited since the last absorb) refuses the whole command before
# anything is read from the host, exit 4. Every line of both files is then
# checked with hs_absorb_check_no_home_path before anything is written or
# printed -- this repository is public, and absorb is the one command most
# able to leak a real path into it -- a hit refuses with exit 2 and writes
# nothing. --dry-run prints both files' content to stdout and writes
# neither. A real run writes each file via a temporary file in the
# manifest directory, then renames it over the target, so neither file is
# ever observed half-written; nothing outside the manifest directory is
# touched.
cmd_absorb() {
  local manifest_dir="$HS_ROOT/manifest"
  local plugins_out="$manifest_dir/plugins.list"
  local config_out="$manifest_dir/config.toml"

  hs_require_clean_manifest "$HS_ROOT" || return "$?"

  local plugins_tmp config_tmp
  plugins_tmp="$(mktemp)" || return 2
  config_tmp="$(mktemp)" || { rm -f "$plugins_tmp"; return 2; }

  local rc=0
  hs_absorb_plugins "$(hs_plugins_json_path)" > "$plugins_tmp" || rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$plugins_tmp" "$config_tmp"
    return 2
  fi

  hs_absorb_config "$(hs_config_toml_path)" > "$config_tmp" || rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$plugins_tmp" "$config_tmp"
    return 2
  fi

  if ! hs_absorb_check_no_home_path "$plugins_tmp"; then
    echo "herdr-setup: absorb: refusing to write $plugins_out: it would contain a home directory path" >&2
    rm -f "$plugins_tmp" "$config_tmp"
    return 2
  fi
  if ! hs_absorb_check_no_home_path "$config_tmp"; then
    echo "herdr-setup: absorb: refusing to write $config_out: it would contain a home directory path" >&2
    rm -f "$plugins_tmp" "$config_tmp"
    return 2
  fi

  if [ "$HS_DRY_RUN" -eq 1 ]; then
    echo "+ $plugins_out"
    cat "$plugins_tmp"
    echo "+ $config_out"
    cat "$config_tmp"
    rm -f "$plugins_tmp" "$config_tmp"
    return 0
  fi

  mkdir -p "$manifest_dir"

  local write_tmp
  write_tmp="$(mktemp "$manifest_dir/.herdr-setup-absorb.XXXXXX")" || {
    rm -f "$plugins_tmp" "$config_tmp"
    return 2
  }
  cat "$plugins_tmp" > "$write_tmp"
  mv -f "$write_tmp" "$plugins_out"
  rm -f "$plugins_tmp"

  write_tmp="$(mktemp "$manifest_dir/.herdr-setup-absorb.XXXXXX")" || {
    rm -f "$config_tmp"
    return 2
  }
  cat "$config_tmp" > "$write_tmp"
  mv -f "$write_tmp" "$config_out"
  rm -f "$config_tmp"

  return 0
}
cmd_onboard() { echo "stub: onboard dry-run=$HS_DRY_RUN yes=$HS_YES"; }
cmd_feed()    { echo "stub: feed dry-run=$HS_DRY_RUN yes=$HS_YES"; }

# bash 3.2 (and up to 4.3) treats expansion of an EMPTY array under `set -u`
# as an unbound variable, and HS_ARGS is empty for every documented
# invocation. The `+` form expands to nothing at all when the array is
# empty, which is the portable idiom.
"cmd_$HS_COMMAND" ${HS_ARGS[@]+"${HS_ARGS[@]}"}
