#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""adapters/codex -- Codex CLI, heuristic, by directory.

Codex keeps no per-process session file. Instead it writes one rollout file
per session at
`<config>/sessions/<yyyy>/<mm>/<dd>/rollout-<timestamp>-<id>.jsonl`, whose
FIRST line is a `session_meta` record carrying the working directory the
session started in. Two panes open in the same directory look identical to
this adapter and one of them may well be wrong, so it is `heuristic` and
never promotes a lone match to `exact` -- see docs/adapters.md.

`<config>` is `$CODEX_HOME` if set, else `$HOME/.codex`, mirroring how
adapters/claude resolves `$CLAUDE_CONFIG_DIR`. Codex CLI itself honours
`$CODEX_HOME` for this same directory.

See tests/fixtures/codex/README.md for where the shape below comes from --
a capture, not a guess, per the discipline tests/fixtures/herdr/ established.

Two performance details the phase's own brief calls for:

- **Only the first line of each rollout is read.** The rest of the file is
  the actual transcript, which can be arbitrarily long; this adapter never
  needs it.
- **The scan is bounded to the newest 30 day directories.** A long history
  must not make `feed` slow. Day-directory names are always zero-padded
  (`yyyy`, `mm`, `dd`), so sorting them as strings is already chronological
  order -- no integer parsing needed to find the newest ones.

Never opens the Herdr socket. The runner decides; this adapter only answers.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import UTC, datetime
from pathlib import Path

AGENT = "codex"
SOURCE = "herdr:codex"

MAX_DAY_DIRS = 30

# `--since <days>` is by file MODIFICATION TIME (docs/adapters.md's own
# "Bounded" rule), not by any timestamp recorded inside the file. Named and
# shaped identically in adapters/claude, by convention -- adapters never
# import each other, any more than they import lib/feed.py.
SECONDS_PER_DAY = 86400

# This adapter's own copy of lib/feed.py's branch_name_ok -- see
# adapters/claude's identical comment. Kept in sync by
# tests/test_adapter_codex_sessions.py running both filters over the same
# shared name list (tests/helpers/feedlib.py's UNREAL_BRANCH_NAMES /
# REAL_BRANCH_NAMES).
_UNREAL_EXACT_NAMES = frozenset({"", "main", "master", "HEAD"})
_UNREAL_PREFIX = "worktree-agent-"
_GIT_INVALID_CHARS = set("~^:?*[\\")
_GIT_INVALID_SUBSTRINGS = ("..", "@{", "//")
_TEMPLATE_CHARS = set("<>{}|;&()'\"`")


def config_dir() -> Path:
    override = os.environ.get("CODEX_HOME")
    if override:
        return Path(override)
    return Path.home() / ".codex"


def sessions_dir() -> Path:
    return config_dir() / "sessions"


def newest_day_dirs(root: Path, limit: int = MAX_DAY_DIRS) -> list[Path]:
    """The `limit` newest `<yyyy>/<mm>/<dd>` directories under `root`.

    Zero-padded names sort chronologically as plain strings, so this needs
    no date parsing. Anything that is not a directory, at any level, is
    quietly skipped rather than raised on -- a stray file here is not this
    adapter's problem to fail over.
    """
    days = []
    if not root.is_dir():
        return days
    for year_dir in root.iterdir():
        if not year_dir.is_dir():
            continue
        for month_dir in year_dir.iterdir():
            if not month_dir.is_dir():
                continue
            for day_dir in month_dir.iterdir():
                if not day_dir.is_dir():
                    continue
                days.append(day_dir)
    days.sort(key=lambda p: (p.parent.parent.name, p.parent.name, p.name), reverse=True)
    return days[:limit]


def read_session_meta(path: Path) -> dict | None:
    """The `payload` of a rollout's first line, or None if it is not usable.

    None covers every way a rollout can fail to answer: unreadable, not
    JSON, JSON but not an object, or an object whose `type` is not
    `session_meta`. All are skipped, never fatal -- one broken or
    in-progress rollout must not stop the others from being found.
    """
    try:
        with path.open(encoding="utf-8") as handle:
            first_line = handle.readline()
    except OSError:
        return None
    if not first_line.strip():
        return None
    try:
        record = json.loads(first_line)
    except ValueError:
        return None
    if not isinstance(record, dict) or record.get("type") != "session_meta":
        return None
    payload = record.get("payload")
    return payload if isinstance(payload, dict) else None


def label_for(payload: dict) -> str:
    timestamp = payload.get("timestamp")
    return str(timestamp) if timestamp else str(payload.get("id", ""))


def sort_key(payload: dict) -> str:
    timestamp = payload.get("timestamp")
    return str(timestamp) if isinstance(timestamp, str) else ""


def sessions_for_cwd(cwd: str) -> list[dict]:
    """Every session_meta payload under `cwd`, newest first."""
    matches = []
    for day_dir in newest_day_dirs(sessions_dir()):
        for rollout in sorted(day_dir.glob("rollout-*.jsonl")):
            payload = read_session_meta(rollout)
            if payload is None or payload.get("cwd") != cwd:
                continue
            matches.append((payload, rollout))
    matches.sort(key=lambda item: sort_key(item[0]), reverse=True)
    return [payload for payload, _rollout in matches]


def candidates_for(cwd) -> list[dict]:
    if not isinstance(cwd, str) or not cwd:
        return []
    candidates = []
    for payload in sessions_for_cwd(cwd):
        session_id = payload.get("id")
        if not isinstance(session_id, str) or not session_id:
            continue
        candidates.append(
            {
                "session_id": session_id,
                "label": label_for(payload),
                "confidence": "heuristic",
            }
        )
    return candidates


def branch_name_ok(name: str) -> bool:
    """This adapter's own copy of lib/feed.py's branch_name_ok -- see above."""
    if not isinstance(name, str) or not name:
        return False
    if name in _UNREAL_EXACT_NAMES:
        return False
    if name.startswith(_UNREAL_PREFIX):
        return False
    if "$" in name:
        return False
    if name.startswith("-"):
        return False
    if any(c.isspace() or ord(c) < 0x20 or ord(c) == 0x7F for c in name):
        return False
    if any(c in _GIT_INVALID_CHARS for c in name):
        return False
    if any(sub in name for sub in _GIT_INVALID_SUBSTRINGS):
        return False
    if name.startswith("/") or name.endswith("/"):
        return False
    if name.endswith(".") or name.endswith(".lock"):
        return False
    if any(part.startswith(".") for part in name.split("/")):
        return False
    return not any(c in _TEMPLATE_CHARS for c in name)


def cmd_probe() -> int:
    available = sessions_dir().is_dir()
    print(
        json.dumps(
            {
                "agent": AGENT,
                "source": SOURCE,
                "available": available,
                "confidence": "heuristic",
                "sessions": True,
            }
        )
    )
    return 0


def cmd_resolve() -> int:
    payload = json.loads(sys.stdin.read() or "{}")
    panes = payload.get("panes") or []
    results = [
        {"pane_id": pane.get("pane_id"), "candidates": candidates_for(pane.get("cwd"))}
        for pane in panes
    ]
    print(json.dumps({"results": results}))
    return 0


# --------------------------------------------------------------------------
# The `sessions` query (docs/adapters.md, "The sessions query" > "Codex")
# --------------------------------------------------------------------------
#
# Version 1 limits, stated in the contract: no command parsing at all (the
# only evidence this adapter can ever report is `session-meta`, straight off
# the rollout's own first line), and `--include-sdk` is accepted so the
# argument parser never rejects it, then simply ignored -- a rollout carries
# nothing this adapter can use to tell an automated caller from a person.


def since_cutoff(days: int) -> float:
    """The epoch-seconds mtime cutoff `--since <days>` names: now minus `days`."""
    return time.time() - days * SECONDS_PER_DAY


def rollout_files() -> list[Path]:
    """Every rollout file: `<config>/sessions/*/*/*/rollout-*.jsonl`.

    Unlike candidates_for()'s own newest_day_dirs() (bounded to 30 day
    directories, a resolve()-specific performance limit the phase brief
    scopes to that function alone), this walks every day directory --
    `--since` and the per-file mtime check below are this query's own bound.
    """
    root = sessions_dir()
    if not root.is_dir():
        return []
    return sorted(root.glob("*/*/*/rollout-*.jsonl"))


def read_first_record(path: Path) -> dict | None:
    """The first line of a rollout, parsed, or None if it is not usable.

    Bytes are read and decoded with errors="replace" (matching
    adapters/claude's own tolerance), so one bad byte on the SECOND line of
    a rollout -- which this never reads at all -- or in the first line
    itself downgrades to "unparseable", never an exception.
    """
    try:
        with path.open("rb") as handle:
            first_line = handle.readline()
    except OSError:
        return None
    if not first_line.strip():
        return None
    try:
        record = json.loads(first_line.decode("utf-8", errors="replace"))
    except ValueError:
        return None
    return record if isinstance(record, dict) else None


def _file_mtime_z(path: Path) -> str | None:
    try:
        epoch = path.stat().st_mtime
    except OSError:
        return None
    return datetime.fromtimestamp(epoch, tz=UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def derive_session(path: Path) -> dict | None:
    """One session record out of one rollout file, or None to report nothing.

    None covers: the first line is not a `session_meta` record, it has no
    usable `id`/`cwd`, or `payload.parent_thread_id` is set -- a sub-thread
    (subagent or guardian), Codex's counterpart of a Claude subagent
    transcript, which is skipped entirely rather than reported as its own
    session.
    """
    record = read_first_record(path)
    if record is None or record.get("type") != "session_meta":
        return None
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return None
    if payload.get("parent_thread_id"):
        return None

    session_id = payload.get("id")
    cwd = payload.get("cwd")
    if not isinstance(session_id, str) or not session_id:
        return None
    if not isinstance(cwd, str) or not cwd:
        return None

    last_active = _file_mtime_z(path)
    if last_active is None:
        return None

    branches: list[dict] = []
    git = payload.get("git")
    if isinstance(git, dict):
        branch = git.get("branch")
        seen_at = payload.get("timestamp")
        if (
            isinstance(branch, str)
            and branch
            and isinstance(seen_at, str)
            and seen_at
            and branch_name_ok(branch)
        ):
            branches.append(
                {"name": branch, "dir": cwd, "evidence": "session-meta", "seen_at": seen_at}
            )

    return {"id": session_id, "cwd": cwd, "last_active": last_active, "branches": branches}


def cmd_sessions(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="adapters/codex sessions", add_help=False)
    parser.add_argument("--since", type=int, required=True)
    parser.add_argument("--include-sdk", action="store_true")
    args = parser.parse_args(argv)

    cutoff = since_cutoff(args.since)
    sessions: list[dict] = []
    for path in rollout_files():
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if mtime < cutoff:
            continue
        session = derive_session(path)
        if session is not None:
            sessions.append(session)

    print(json.dumps({"sessions": sessions}))
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 1 and argv[0] == "probe":
        return cmd_probe()
    if len(argv) == 1 and argv[0] == "resolve":
        return cmd_resolve()
    if argv and argv[0] == "sessions":
        return cmd_sessions(argv[1:])
    sys.stderr.write(
        "usage: adapters/codex probe|resolve|sessions --since <days> [--include-sdk]\n"
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
